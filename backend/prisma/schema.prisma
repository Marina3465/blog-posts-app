// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  userTag   String  @unique
  email     String? @unique
  password  String? // Опциональный, так как у пользователей Google пароля нет
  googleId  String? @unique // ID от Google (если вошел через Google)
  avatar    String?
  likes     Like[]
  posts     Post[]
}

model Post {
  id             Int      @id @default(autoincrement())
  author         String // денормализация: имя автора на момент публикации
  userTag        String // то же для тега
  text           String
  comments       Int      @default(0)
  dateOfCreation DateTime @default(now())
  authorId       Int? // связь с автором; null у постов, созданных до авторизации
  authorUser     User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes          Like[]
  attachments    Attachment[]
}

model Like {
  id     Int  @id @default(autoincrement())
  userId Int
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId]) // Один пользователь может лайкнуть пост только 1 раз
}

model Attachment {
  id           Int    @id @default(autoincrement())
  postId       Int
  filename     String // имя файла на диске (uuid + расширение)
  originalName String // как файл назывался у пользователя
  mimeType     String
  size         Int    // в байтах
  post         Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}
